# ============================================================
# Configuración de pruebas del backend - EJEMPLO
# Copia este archivo a .env.test para ejecutar las pruebas.
# ============================================================

NODE_ENV=test
PORT=3100
DATABASE_URL=postgresql://usuario:password@localhost:5432/finanzas_test
JWT_SECRET=secret-de-pruebas-reemplazar
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_IDLE_TIMEOUT=30m
COOKIE_NAME=finanzas_auth
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:4200
BCRYPT_ROUNDS=10
